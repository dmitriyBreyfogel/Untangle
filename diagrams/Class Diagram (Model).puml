@startuml
title Диаграмма классов (Модель)

skinparam classAttributeIconSize 0
hide circle

package model.core {
    class Игра {
        - номерТекущегоУровня : int
        - максимальныйПройденныйУровень : int
        - счетчикХодов : int
        - запущена : boolean
        - фабрикаУровней : ФабрикаУровней
        - текущийУровень : Уровень
        + Игра()
        ~ Игра(фабрикаУровней : ФабрикаУровней)
        + начать() : void
        + начатьСУровня(номерУровня : int) : void
        + продолжитьИгру() : void
        + завершить() : void
        - загрузитьУровень(номерУровня : int) : void
        - загрузитьУровень(уровень : Уровень) : void
        - уровеньПройден() : boolean
        + перезапуститьТекущийУровень() : void
        ~ зарегистрироватьХод() : void
        - проверитьХод() : void
        - завершитьТекущийУровень() : void
        - перейтиКСледующемуУровню() : void
        - сброситьСчетчикХодов() : void
        + естьПрогрессДляПродолжения() : boolean
        + номерУровняДляПродолжения() : int
        + номерТекущегоУровня() : int
        + максимальныйПройденныйУровень() : int
        + счетчикХодов() : int
        + запущена() : boolean
        + текущийУровень() : Уровень
        - уровеньСуществует(номерУровня : int) : boolean
    }

    class ИгровоеПоле {
        - ширина : double
        - высота : double
        - схема : Схема
        + ИгровоеПоле(ширина : double, высота : double, схема : Схема)
        + можноРазместить(точка : Point2D) : boolean
        + ширина() : double
        + высота() : double
        + схема() : Схема
    }

    class Схема {
        - стратегияДвиженияПоУмолчанию : СтратегияДвижения
        - начальныеКоординатыУзлов : List<Point2D.Double>
        - соединенияУзлов : Map<Integer, List<Integer>>
        - стратегииДвиженияУзлов : Map<Integer, СтратегияДвижения>
        - узлы : List<Узел>
        - ребра : List<Ребро>
        - игровоеПоле : ИгровоеПоле
        - игра : Игра
        - Схема(начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>, стратегииДвиженияУзлов : Map<Integer, СтратегияДвижения>)
        + {static} создать(начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>) : Схема
        + {static} создать(начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>, стратегииДвиженияУзлов : Map<Integer, СтратегияДвижения>) : Схема
        + сбросить() : void
        + переместитьУзел(узел : Узел, целеваяПозиция : Point2D) : void
        + получитьПересекающиесяРебра() : List<Ребро>
        + получитьПересекающиесяРебраПослеХода(узел : Узел, целеваяПозиция : Point2D) : List<Ребро>
        + естьПересечения() : boolean
        + получитьРебраУзла(узел : Узел) : List<Ребро>
        + получитьУзлы() : List<Узел>
        + получитьРебра() : List<Ребро>
        ~ привязатьИгровоеПоле(игровоеПоле : ИгровоеПоле) : void
        ~ привязатьИгру(игра : Игра) : void
        - проверитьПринадлежностьУзлаСхеме(узел : Узел) : void
        - обновитьИнцидентныеРебра(узел : Узел) : void
        - обновитьГеометриюСхемы() : void
        - обновитьПересечения() : void
        - пересекаютсяПослеХода(первоеРебро : Ребро, второеРебро : Ребро, перемещаемыйУзел : Узел, позицияПослеХода : Point2D) : boolean
        - точкаУзла(узел : Узел, перемещаемыйУзел : Узел, позицияПослеХода : Point2D) : Point2D
        - построитьРебра() : List<Ребро>
        - проверитьОтсутствиеИзолированныхУзлов() : void
        - проверитьИндексыСтратегийДвижения() : void
        - {static} глубокаяКопия(словарь : Map<Integer, List<Integer>>) : Map<Integer, List<Integer>>
        - {static} копия(точка : Point2D, имяПараметра : String) : Point2D.Double
    }

    class Узел {
        - стратегияДвиженияПоУмолчанию : СтратегияДвижения
        - позиция : Point2D.Double
        - стратегияДвижения : СтратегияДвижения
        ~ Узел(позиция : Point2D)
        ~ Узел(позиция : Point2D, стратегияДвижения : СтратегияДвижения)
        + получитьX() : double
        + получитьY() : double
        + рассчитатьПозициюПослеХода(целеваяПозиция : Point2D) : Point2D
        + получитьСтратегиюДвижения() : СтратегияДвижения
        ~ получитьПозицию() : Point2D
        ~ переместитьНапрямуюВ(целеваяПозиция : Point2D) : void
        ~ находитсяВ(целеваяПозиция : Point2D) : boolean
        - {static} копия(точка : Point2D, имяПараметра : String) : Point2D.Double
    }

    class Ребро {
        - узелA : Узел
        - узелB : Узел
        - начало : Point2D.Double
        - конец : Point2D.Double
        - пересекающееся : boolean
        ~ Ребро(узелA : Узел, узелB : Узел)
        ~ обновитьГеометрию() : void
        ~ пересекаетсяС(другоеРебро : Ребро) : boolean
        ~ содержитУзел(узел : Узел) : boolean
        + являетсяПересекающимся() : boolean
        ~ установитьПересечение(пересекающееся : boolean) : void
        + получитьУзелA() : Узел
        + получитьУзелB() : Узел
        ~ {static} строгоПересекаются(точкаA1 : Point2D, точкаA2 : Point2D, точкаB1 : Point2D, точкаB2 : Point2D) : boolean
        - {static} ориентация(точкаA : Point2D, точкаB : Point2D, точкаC : Point2D) : int
        - {static} копия(точка : Point2D) : Point2D.Double
    }
}

package model.level {
    class Уровень {
        - номер : int
        - схема : Схема
        - игровоеПоле : ИгровоеПоле
        ~ Уровень(номер : int, начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>, ширинаПоля : double, высотаПоля : double)
        ~ Уровень(номер : int, начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>, стратегииДвиженияУзлов : Map<Integer, СтратегияДвижения>, ширинаПоля : double, высотаПоля : double)
        + сбросить() : void
        + номер() : int
        + игровоеПоле() : ИгровоеПоле
        + схема() : Схема
    }

    class ФабрикаУровней {
        - ширинаПоляПоУмолчанию : double
        - высотаПоляПоУмолчанию : double
        - последнийНомерУровня : int
        + доступныеНомераУровней() : List<Integer>
        + создатьУровень(номер : int) : Уровень
    }
}

Игра o-- ФабрикаУровней : фабрикаУровней
Игра --> Уровень : текущийУровень
ФабрикаУровней ..> Уровень : создает
Уровень *-- Схема : схема
Уровень *-- ИгровоеПоле : игровоеПоле
ИгровоеПоле --> Схема : привязывает
Схема *-- Узел : узлы
Схема *-- Ребро : ребра
Схема --> ИгровоеПоле : игровоеПоле
Схема --> Игра : игра
Ребро --> Узел : узелA
Ребро --> Узел : узелB

@enduml

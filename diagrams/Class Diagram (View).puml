        ~ отрисоватьУзлы(графика : Graphics2D, модельИгры : Игра, палитраГрафа : ПалитраГрафа) : void
        ~ отрисоватьУзлы(графика : Graphics2D, модельИгры : Игра, выбранныйУзел : Узел, позицияВыбранногоУзла : Point2D, палитраГрафа : ПалитраГрафа) : void

        + showWindow() : void
        - configureWindow() : void
        - assembleLayout() : void
        - chooseLevel() : void
        - openGame(game : Game) : void
        - exitApplication() : void
    }

    class LevelSelectionDialog <<JDialog>> {
        - selectedLevelNumber : Integer
        ~ LevelSelectionDialog(owner : Frame, levelNumbers : List<Integer>)
        ~ showDialog() : Integer
        - configureDialog() : void
        - assembleLayout(levelNumbers : List<Integer>) : void
        - createLevelButton(levelNumber : int) : JButton
        - selectLevel(levelNumber : int) : void
    }

    class GameSessionLauncher {
        - levelFactory : LevelFactory
        ~ newGame() : Game
        ~ gameAtLevel(levelNumber : int) : Game
        ~ availableLevelNumbers() : List<Integer>
    }
}


@startuml
title Model sequence: start new game

actor Client
participant "Game" as Game
participant "LevelFactory" as LevelFactory
participant "Level" as Level
participant "Scheme" as Scheme
participant "GameField" as GameField

Client -> Game : start()
Game -> Game : startAtLevel(1)
Game -> LevelFactory : createLevel(1)
create Level
LevelFactory --> Level : new Level(...)
Level -> Scheme : create(coordinates, connections, strategies)
create Scheme
Scheme --> Level : scheme
create GameField
Level -> GameField : new GameField(width, height, scheme)
GameField -> Scheme : bindGameField(this)
GameField --> Level : gameField
LevelFactory --> Game : level
Game -> Game : resetMoveCounter()
Game -> Game : loadLevel(level)
Game -> Level : number()
Game -> Level : scheme()
Level --> Game : scheme
Game -> Scheme : bindGame(this)
Game --> Client : started game

@enduml

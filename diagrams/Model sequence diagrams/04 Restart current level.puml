@startuml
title Модель: перезапуск текущего уровня

actor Клиент
participant "Игра" as Игра
participant "ФабрикаУровней" as ФабрикаУровней
participant "Уровень" as Уровень

Клиент -> Игра : перезапуститьТекущийУровень()
alt текущийУровень отсутствует
    Игра --> Клиент : изменений нет
else текущийУровень существует
    Игра -> Игра : сброситьСчетчикХодов()
    Игра -> Игра : загрузитьУровень(номерТекущегоУровня)
    Игра -> ФабрикаУровней : создатьУровень(номерТекущегоУровня)
    ФабрикаУровней --> Игра : уровень
    Игра -> Игра : загрузитьУровень(уровень)
    Игра -> Уровень : номер()
    Уровень --> Игра : номер
    Игра --> Клиент : уровень перезапущен
end

@enduml

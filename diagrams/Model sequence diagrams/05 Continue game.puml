@startuml
title Модель: продолжение игры

actor Клиент
participant "Игра" as Игра
participant "ФабрикаУровней" as ФабрикаУровней
participant "Уровень" as Уровень

Клиент -> Игра : продолжитьИгру()
Игра -> Игра : естьПрогрессДляПродолжения()
alt игра уже запущена или прогресса нет
    Игра --> Клиент : изменений нет
else прогресс есть
    Игра -> Игра : сброситьСчетчикХодов()
    Игра -> Игра : номерУровняДляПродолжения()
    Игра -> Игра : уровеньСуществует(номерСледующегоОткрытогоУровня)
    Игра -> ФабрикаУровней : создатьУровень(номерУровня)
    ФабрикаУровней --> Игра : уровень
    Игра -> Игра : загрузитьУровень(уровень)
    Игра -> Уровень : номер()
    Уровень --> Игра : номер
    Игра --> Клиент : игра продолжена
end

@enduml

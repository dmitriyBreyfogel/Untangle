@startuml
title Диаграмма классов (Модель): точка расширения

skinparam classAttributeIconSize 0
hide circle

package model.core {
    class Схема {
        - стратегияДвиженияПоУмолчанию : СтратегияДвижения
        - начальныеКоординатыУзлов : List<Point2D.Double>
        - соединенияУзлов : Map<Integer, List<Integer>>
        - стратегииДвиженияУзлов : Map<Integer, СтратегияДвижения>
        - узлы : List<Узел>
        - ребра : List<Ребро>
        - игровоеПоле : ИгровоеПоле
        - игра : Игра
        - Схема(начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>, стратегииДвиженияУзлов : Map<Integer, СтратегияДвижения>)
        + {static} создать(начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>) : Схема
        + {static} создать(начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>, стратегииДвиженияУзлов : Map<Integer, СтратегияДвижения>) : Схема
        + сбросить() : void
        + переместитьУзел(узел : Узел, целеваяПозиция : Point2D) : void
        + получитьПересекающиесяРебра() : List<Ребро>
        + получитьПересекающиесяРебраПослеХода(узел : Узел, целеваяПозиция : Point2D) : List<Ребро>
        + естьПересечения() : boolean
        + получитьРебраУзла(узел : Узел) : List<Ребро>
        + получитьУзлы() : List<Узел>
        + получитьРебра() : List<Ребро>
        ~ привязатьИгровоеПоле(игровоеПоле : ИгровоеПоле) : void
        ~ привязатьИгру(игра : Игра) : void
        - проверитьИндексыСтратегийДвижения() : void
    }

    class Узел {
        - стратегияДвиженияПоУмолчанию : СтратегияДвижения
        - позиция : Point2D.Double
        - стратегияДвижения : СтратегияДвижения
        ~ Узел(позиция : Point2D)
        ~ Узел(позиция : Point2D, стратегияДвижения : СтратегияДвижения)
        + получитьX() : double
        + получитьY() : double
        + рассчитатьПозициюПослеХода(целеваяПозиция : Point2D) : Point2D
        + получитьСтратегиюДвижения() : СтратегияДвижения
        ~ получитьПозицию() : Point2D
        ~ переместитьНапрямуюВ(целеваяПозиция : Point2D) : void
        ~ находитсяВ(целеваяПозиция : Point2D) : boolean
    }
}

package model.level {
    class Уровень {
        - номер : int
        - схема : Схема
        - игровоеПоле : ИгровоеПоле
        ~ Уровень(номер : int, начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>, ширинаПоля : double, высотаПоля : double)
        ~ Уровень(номер : int, начальныеКоординатыУзлов : List<Point2D>, соединенияУзлов : Map<Integer, List<Integer>>, стратегииДвиженияУзлов : Map<Integer, СтратегияДвижения>, ширинаПоля : double, высотаПоля : double)
        + сбросить() : void
        + номер() : int
        + игровоеПоле() : ИгровоеПоле
        + схема() : Схема
    }

    class ФабрикаУровней {
        - ширинаПоляПоУмолчанию : double
        - высотаПоляПоУмолчанию : double
        - последнийНомерУровня : int
        + доступныеНомераУровней() : List<Integer>
        + создатьУровень(номер : int) : Уровень
    }
}

package model.movement {
    interface СтратегияДвижения {
        + рассчитатьПозициюПослеХода(текущаяПозиция : Point2D, запрошеннаяПозиция : Point2D) : Point2D
    }

    class СтратегияСвободногоДвижения {
        + рассчитатьПозициюПослеХода(текущаяПозиция : Point2D, запрошеннаяПозиция : Point2D) : Point2D
    }

    class СтратегияФиксированногоДвижения {
        + рассчитатьПозициюПослеХода(текущаяПозиция : Point2D, запрошеннаяПозиция : Point2D) : Point2D
    }

    class СтратегияГоризонтальногоДвижения {
        + рассчитатьПозициюПослеХода(текущаяПозиция : Point2D, запрошеннаяПозиция : Point2D) : Point2D
    }
}

СтратегияДвижения <|.. СтратегияСвободногоДвижения
СтратегияДвижения <|.. СтратегияФиксированногоДвижения
СтратегияДвижения <|.. СтратегияГоризонтальногоДвижения

ФабрикаУровней ..> СтратегияСвободногоДвижения : создает
ФабрикаУровней ..> СтратегияФиксированногоДвижения : создает
ФабрикаУровней ..> СтратегияГоризонтальногоДвижения : создает
Уровень ..> СтратегияДвижения : передает словарь
Схема --> СтратегияДвижения : хранит по узел индекс
Схема *-- Узел : создает
Узел --> СтратегияДвижения : делегирует движение

@enduml

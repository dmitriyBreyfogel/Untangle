@startuml
title Диаграмма классов (Представление): точка расширения

skinparam classAttributeIconSize 0
hide circle

package view.render {
    class ОтрисовщикИгровогоПоля {
        - {static} цветОбычногоРебраПоУмолчанию : Color
        - {static} цветПересекающегосяРебраПоУмолчанию : Color
        - {static} цветУзлаПоУмолчанию : Color
        - {static} цветВыбранногоУзлаПоУмолчанию : Color
        - параметрыПоля : ПараметрыПоля
        - цветОбычногоРебра : Color
        - цветПересекающегосяРебра : Color
        - цветУзла : Color
        - цветВыбранногоУзла : Color
        - отрисовщикГрафа : ОтрисовщикГрафа
        - отрисовщикДоски : ОтрисовщикДоски
        + ОтрисовщикИгровогоПоля(параметрыПоля : ПараметрыПоля)
        + ОтрисовщикИгровогоПоля(параметрыПоля : ПараметрыПоля, реестрСтратегийОтрисовкиУзлов : РеестрСтратегийОтрисовкиУзлов)
        + ОтрисовщикИгровогоПоля(параметрыПоля : ПараметрыПоля, цветОбычногоРебра : Color, цветПересекающегосяРебра : Color, цветУзла : Color, цветВыбранногоУзла : Color)
        + ОтрисовщикИгровогоПоля(параметрыПоля : ПараметрыПоля, цветОбычногоРебра : Color, цветПересекающегосяРебра : Color, цветУзла : Color, цветВыбранногоУзла : Color, реестрСтратегийОтрисовкиУзлов : РеестрСтратегийОтрисовкиУзлов)
        + отрисоватьПоле(графика : Graphics2D, модельИгры : Игра, выбранныйУзел : Узел) : void
        + отрисоватьПоле(графика : Graphics2D, модельИгры : Игра, выбранныйУзел : Узел, позицияВыбранногоУзла : Point2D) : void
    }

    class ОтрисовщикГрафа {
        - параметрыПоля : ПараметрыПоля
        - отрисовщикРебер : ОтрисовщикРебер
        - отрисовщикУзлов : ОтрисовщикУзлов
        ~ ОтрисовщикГрафа(параметрыПоля : ПараметрыПоля)
        ~ ОтрисовщикГрафа(параметрыПоля : ПараметрыПоля, реестрСтратегийОтрисовкиУзлов : РеестрСтратегийОтрисовкиУзлов)
        ~ отрисоватьГраф(графика : Graphics2D, модельИгры : Игра) : void
        ~ отрисоватьГраф(графика : Graphics2D, модельИгры : Игра, выбранныйУзел : Узел, позицияВыбранногоУзла : Point2D, цветОбычногоРебра : Color, цветПересекающегосяРебра : Color, цветУзла : Color, цветВыбранногоУзла : Color) : void
    }

    class ОтрисовщикУзлов {
        - параметрыПоля : ПараметрыПоля
        - реестрСтратегийОтрисовкиУзлов : РеестрСтратегийОтрисовкиУзлов
        ~ ОтрисовщикУзлов(параметрыПоля : ПараметрыПоля)
        ~ ОтрисовщикУзлов(параметрыПоля : ПараметрыПоля, реестрСтратегийОтрисовкиУзлов : РеестрСтратегийОтрисовкиУзлов)
        ~ отрисоватьУзлы(графика : Graphics2D, модельИгры : Игра) : void
        ~ отрисоватьУзлы(графика : Graphics2D, модельИгры : Игра, выбранныйУзел : Узел, позицияВыбранногоУзла : Point2D, цветУзла : Color, цветВыбранногоУзла : Color) : void
        ~ отрисоватьУзлы(графика : Graphics2D, модельИгры : Игра, преобразователь : ПреобразовательКоординатПоля, выбранныйУзел : Узел, позицияВыбранногоУзла : Point2D, цветУзла : Color, цветВыбранногоУзла : Color) : void
        - отрисоватьУзел(графика : Graphics2D, преобразователь : ПреобразовательКоординатПоля, узел : Узел, выбранныйУзел : Узел, позицияВыбранногоУзла : Point2D, цвет : Color) : void
        - вЭкраннуюТочку(преобразователь : ПреобразовательКоординатПоля, узел : Узел, выбранныйУзел : Узел, позицияВыбранногоУзла : Point2D) : Point
    }

    class ПараметрыПоля <<record>> {
        + радиусУзла() : int
        + отступПоля() : int
    }

    class ПреобразовательКоординатПоля {
        - параметрыПоля : ПараметрыПоля
        - размерПанели : Dimension
        - ширинаПоля : double
        - высотаПоля : double
        + вЭкранныеКоординаты(точкаМодели : Point2D) : Point
        + вКоординатыМодели(экраннаяТочка : Point) : Point2D
    }
}

package view.render.node {
    interface СтратегияОтрисовкиУзла {
        + отрисовать(графика : Graphics2D, центр : Point, радиус : int, цвет : Color, выбран : boolean) : void
    }

    class РеестрСтратегийОтрисовкиУзлов {
        - стратегииОтрисовки : Map<Class<? extends СтратегияДвижения>, СтратегияОтрисовкиУзла>
        - стратегияОтрисовкиПоУмолчанию : СтратегияОтрисовкиУзла
        + РеестрСтратегийОтрисовкиУзлов(стратегияОтрисовкиПоУмолчанию : СтратегияОтрисовкиУзла)
        + {static} создатьПоУмолчанию() : РеестрСтратегийОтрисовкиУзлов
        + зарегистрировать(типСтратегииДвижения : Class<? extends СтратегияДвижения>, стратегияОтрисовки : СтратегияОтрисовкиУзла) : void
        + выбратьСтратегию(узел : Узел) : СтратегияОтрисовкиУзла
        + выбратьСтратегию(стратегияДвижения : СтратегияДвижения) : СтратегияОтрисовкиУзла
    }

    class СтратегияОбычнойОтрисовкиУзла {
        + отрисовать(графика : Graphics2D, центр : Point, радиус : int, цвет : Color, выбран : boolean) : void
    }

    class СтратегияОтрисовкиФиксированногоУзла {
        - базоваяСтратегияОтрисовки : СтратегияОтрисовкиУзла
        + отрисовать(графика : Graphics2D, центр : Point, радиус : int, цвет : Color, выбран : boolean) : void
    }

    class СтратегияОтрисовкиГоризонтальногоУзла {
        - базоваяСтратегияОтрисовки : СтратегияОтрисовкиУзла
        + отрисовать(графика : Graphics2D, центр : Point, радиус : int, цвет : Color, выбран : boolean) : void
    }
}

СтратегияОтрисовкиУзла <|.. СтратегияОбычнойОтрисовкиУзла
СтратегияОтрисовкиУзла <|.. СтратегияОтрисовкиФиксированногоУзла
СтратегияОтрисовкиУзла <|.. СтратегияОтрисовкиГоризонтальногоУзла
СтратегияОтрисовкиФиксированногоУзла *-- СтратегияОтрисовкиУзла : базоваяСтратегияОтрисовки
СтратегияОтрисовкиГоризонтальногоУзла *-- СтратегияОтрисовкиУзла : базоваяСтратегияОтрисовки
РеестрСтратегийОтрисовкиУзлов o-- СтратегияОтрисовкиУзла : стратегияОтрисовкиПоУмолчанию
РеестрСтратегийОтрисовкиУзлов --> СтратегияОтрисовкиУзла : зарегистрированные стратегии
ОтрисовщикИгровогоПоля *-- ОтрисовщикГрафа
ОтрисовщикГрафа *-- ОтрисовщикУзлов
ОтрисовщикУзлов --> РеестрСтратегийОтрисовкиУзлов
ОтрисовщикУзлов ..> СтратегияОтрисовкиУзла : выбратьСтратегию и отрисовать
ОтрисовщикУзлов ..> ПреобразовательКоординатПоля
ОтрисовщикУзлов ..> ПараметрыПоля

@enduml

@startuml
title Model extension sequence: free movement strategy

actor Client
participant "Scheme" as Scheme
participant "Node" as Node
participant "FreeMovementStrategy" as FreeMovementStrategy
participant "GameField" as GameField

Client -> Scheme : moveNode(freeNode, destination)
Scheme -> Node : resolveMove(destination)
Node -> FreeMovementStrategy : resolveMove(currentPosition, requestedPosition)
FreeMovementStrategy --> Node : requestedPosition
Node --> Scheme : resolvedDestination
Scheme -> GameField : canPlace(resolvedDestination)
GameField --> Scheme : true
Scheme -> Node : isAt(resolvedDestination)
Node --> Scheme : false
Scheme -> Node : moveDirectlyTo(resolvedDestination)
Scheme --> Client : node moved freely

@enduml

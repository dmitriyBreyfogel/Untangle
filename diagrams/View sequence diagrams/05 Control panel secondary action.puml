@startuml
title Представление: вторичное действие панели управления

actor Пользователь
participant "ПанельУправленияИгрой" as ПанельУправленияИгрой
participant "ОкноИгры" as ОкноИгры
participant "Игра" as Игра
participant "ПанельСтатусаИгры" as ПанельСтатусаИгры
participant "ПанельИгровогоПоля" as ПанельИгровогоПоля

Пользователь -> ПанельУправленияИгрой : нажать вторичная кнопка
ПанельУправленияИгрой -> ОкноИгры : обработатьВторичноеДействие()
ОкноИгры -> Игра : запущена()
alt игра запущена
    ОкноИгры -> ОкноИгры : перезапуститьТекущийУровень()
    ОкноИгры -> Игра : текущийУровень()
    Игра --> ОкноИгры : уровень
    ОкноИгры -> Игра : перезапуститьТекущийУровень()
else игра остановлена
    ОкноИгры -> ОкноИгры : продолжитьИгру()
    ОкноИгры -> Игра : продолжитьИгру()
end
ОкноИгры -> ОкноИгры : обновитьПредставление()
ОкноИгры -> ПанельСтатусаИгры : обновитьСостояние()
ОкноИгры -> ПанельИгровогоПоля : обновитьПоле()
ОкноИгры -> ПанельУправленияИгрой : обновитьДоступностьКнопок(запущена, можноПродолжить, номерУровняДляПродолжения)
ОкноИгры --> Пользователь : представление обновлено

@enduml
